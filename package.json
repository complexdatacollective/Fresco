{
  "name": "fresco",
  "version": "4.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build-storybook": "SKIP_ENV_VALIDATION=true storybook build",
    "build:branch-preview": "SKIP_ENV_VALIDATION=true prisma generate && next build",
    "build:platform": "prisma generate && tsx ./scripts/setup-database.ts && tsx ./scripts/initialize.ts && next build",
    "chromatic": "SKIP_ENV_VALIDATION=true pnpx chromatic --exit-zero-on-changes --project-token=chpt_be05032bf2520b5",
    "codegen": "SKIP_ENV_VALIDATION=true prisma generate && SKIP_ENV_VALIDATION=true next typegen",
    "dev": "concurrently -k './scripts/dev-db.sh' 'tsx scripts/dev-s3.ts' 'next dev'",
    "docker-build": "docker build -t fresco:latest .",
    "knip": "SKIP_ENV_VALIDATION=true knip",
    "load-test": "docker run -i grafana/k6 run - <load-test.js",
    "postinstall": "cross-env SKIP_ENV_VALIDATION=true prisma generate && cross-env SKIP_ENV_VALIDATION=true next typegen",
    "start": "next start",
    "storybook": "SKIP_ENV_VALIDATION=true storybook dev -p 6006",
    "test": "SKIP_ENV_VALIDATION=true vitest run --project=units",
    "test:storybook": "SKIP_ENV_VALIDATION=true vitest run --project=storybook",
    "test:watch": "SKIP_ENV_VALIDATION=true vitest --project=units",
    "typecheck": "SKIP_ENV_VALIDATION=true tsc --noEmit",
    "vercel-build": "pnpm build:platform"
  },
