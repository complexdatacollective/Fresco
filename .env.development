# Local development S3 storage — points at the Garage container started by `pnpm dev`
# (scripts/dev-s3.ts). Garage is bootstrapped with exactly these credentials and
# bucket, and the script refuses to start if they drift from its own constants.
# These values are intentional test credentials and are safe to commit.
# To test the full setup wizard, comment out STORAGE_PROVIDER so the provider
# is not pinned and the settings UI stays editable.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GK7264a84895442c56d7af713e
S3_SECRET_ACCESS_KEY=44ddf3da7d056e03767853bba63c422fd60365b6a613c6d367b2b83ab94e55eb
